# Server Port
PORT=5000

# Supabase Database Configuration
# You can find these in your Supabase project dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Optional: Service Role Key for server-side admin writes (bypasses RLS)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct PostgreSQL Connection URI (if connecting via Prisma/Drizzle/pg)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
